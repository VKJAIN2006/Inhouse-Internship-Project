   "source": [
    "# 6) Write a Python program to determine how many elements are in a set without using the built-in len() function. \n",
    "# s = {\"cat\", \"dog\", \"bird\", \"fish\"} "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4bb1a62b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total elements 4\n"
     ]
    }
   ],
   "source": [
    "s = {\"cat\", \"dog\", \"bird\", \"fish\"} \n",
    "\n",
    "el=0\n",
    "\n",
    "for element in s:\n",
    "    el+=1\n",
    "print(\"Total elements\",el)\n",
    "\n"
   ]
  }
