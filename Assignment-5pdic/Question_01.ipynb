   "source": [
    "# 1) Write a Python program to repeat a tuple three times using the * operator. \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f22880dc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original Tuple: (1, 2, 3)\n",
      "Tuple repeated 3 times: (1, 2, 3, 1, 2, 3, 1, 2, 3)\n"
     ]
    }
   ],
   "source": [
    "# Original tuple\n",
    "t = (1, 2, 3)\n",
    "\n",
    "# Repeat the tuple three times\n",
    "result = t * 3\n",
    "\n",
    "# Display the result\n",
    "print(\"Original Tuple:\", t)\n",
    "print(\"Tuple repeated 3 times:\", result)"
   ]
  },
